<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Fixed home header: icon + OBSIDIAN + tagline.
         Shown only on the home screen (no back-stack). Inflated by MainActivity. -->
    <FrameLayout
        android:id="@+id/home_header_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/global_search_container" />

    <!-- Global search bar + drag handle. Same visibility lifecycle as home header — except on
         the dedicated Cerca tab, where the header is hidden and this becomes the top view. -->
    <FrameLayout
        android:id="@+id/global_search_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/home_header_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/fragment_container" />

    <!-- Tab content — RecyclerView starts directly with nav cards (no header adapter). -->
    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/global_search_container"
        app:layout_constraintBottom_toTopOf="@id/nav_divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Global search results overlay — same bounds as fragment_container, z-above it. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/search_results_rv"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/global_search_container"
        app:layout_constraintBottom_toTopOf="@id/nav_divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Shown instead of search_results_rv when the query matches nothing — otherwise
         hiding the (empty) results RV would just reveal the tab underneath, which reads
         as "unfiltered browsing" rather than "no results found". -->
    <TextView
        android:id="@+id/search_empty_tv"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:textColor="#99FFFFFF"
        android:textSize="15sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/global_search_container"
        app:layout_constraintBottom_toTopOf="@id/nav_divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/nav_divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav_host"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- La barra sta dentro un contenitore e 3 dp sopra il fondo della finestra: alcune ROM (RisingOS: LiquidTabBars) trasformano
         in "pillola di vetro" fluttuante ogni barra di navigazione appoggiata sul fondo, che copre la fine delle pagine e
         cambia i colori scelti. Staccata di 3 dp la ROM la lascia com'e'. -->
    <FrameLayout
        android:id="@+id/bottom_nav_host"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            app:menu="@menu/bottom_nav_menu"
            app:labelVisibilityMode="labeled" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
