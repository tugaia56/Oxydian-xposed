<?xml version="1.0" encoding="utf-8"?>
<!-- Stile 71 — orologio analogico "Colorful" (quadrante dal tema "Outher Out Stock 2"). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <AnalogClock
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_marginVertical="10dp"
        android:dial="@drawable/analog_colorful_dial"
        android:hand_hour="@drawable/analog_hf62888_hour"
        android:hand_minute="@drawable/analog_hf62888_min"
        android:hand_second="@drawable/analog_hf62888_sec" />
</LinearLayout>
