<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- LSPosed scope per Android puro (crDroid, ecc.): sostituisce l'elenco di OxygenOS (src/main). Impostazioni (finestra trasparente), SystemUI
         (trasparenza del pannello) e le app di Google/terze parti che hanno un mod proprio (Contatti, Messaggi, Orologio, Meteo, Sicurezza personale, Solid Explorer); il resto del modulo e' spento su queste ROM. -->
    <string-array name="xposed_scope">
        <item>com.android.settings</item>
        <item>com.android.systemui</item>
        <item>com.google.android.contacts</item>
        <item>com.google.android.apps.messaging</item>
        <item>com.google.android.deskclock</item>
        <item>com.google.android.apps.weather</item>
        <item>com.google.android.apps.safetyhub</item>
        <item>pl.solidexplorer2</item>
    </string-array>
</resources>
